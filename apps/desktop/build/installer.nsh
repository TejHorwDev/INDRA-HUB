; ---------------------------------------------------------------------------
; INDRA HUB — installer wording
;
; electron-builder includes this file before it declares the wizard's pages, so
; these are the strings MUI2 reads when the pages are built. The stock wizard
; says "Welcome to the INDRA HUB Setup Wizard" and nothing else; this says what
; the app is, that work is local, and what signing in adds.
;
; The pictures beside these pages are generated by scripts/make-installer-art.py.
; ---------------------------------------------------------------------------

!define MUI_WELCOMEPAGE_TITLE "INDRA HUB"

!define MUI_WELCOMEPAGE_TEXT "A desktop workspace for projects, notes, decks and the team around them.$\r$\n$\r$\nEverything you write is saved on this PC, and works with no connection at all. Signing in also keeps your workspace settings, AI allowance and profile picture on the server.$\r$\n$\r$\nThis installs the app for you, with a shortcut on the desktop and in the Start menu."

!define MUI_DIRECTORYPAGE_TEXT_TOP "INDRA HUB installs here. Projects, accounts and pictures live outside this folder, so changing it never moves your work."

!define MUI_FINISHPAGE_TITLE "INDRA HUB is ready"

!define MUI_FINISHPAGE_TEXT "Updates are checked every time the app opens, so this copy keeps itself current.$\r$\n$\r$\nYour work stays on this PC."

!define MUI_FINISHPAGE_RUN_TEXT "Open INDRA HUB"

; No marketing page, just the place the app actually lives.
!define MUI_FINISHPAGE_LINK "INDRA HUB on GitHub"
!define MUI_FINISHPAGE_LINK_LOCATION "https://github.com/TejHorwDev/INDRA-HUB"
