# ------------------------------------------------------------------ database --
# Supabase. The service role key bypasses RLS, which is the point: RLS is on with
# no policy so that nothing else can reach these tables. This key is server-only
# and must never be exposed to a browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------- admin login --
# One administrator. Set ADMIN_PASSWORD to something long; it is hashed in memory
# at boot and never stored.
ADMIN_USERNAME=tej
ADMIN_PASSWORD=
# 32+ random characters. Rotating it signs every session out.
ADMIN_SESSION_SECRET=

# -------------------------------------------------------------- object store --
# r2 | b2 | supabase | local. Empty picks the first one that has credentials.
STORAGE_DRIVER=

# Cloudflare R2 (preferred: egress is free)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=indra-loader

# Backblaze B2 (S3-compatible)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# Supabase Storage, used only if neither of the above is configured
SUPABASE_BUCKET=indra-loader

# Optional. When set, files are served from this base instead of through the API.
# Leave empty and the API proxies them, which works with a private bucket.
PUBLIC_BASE_URL=
