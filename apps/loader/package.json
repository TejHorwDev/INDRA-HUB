{
  "name": "indra-loader",
  "productName": "INDRA LOADER",
  "version": "0.1.0",
  "private": true,
  "description": "INDRA LOADER \u2014 app launcher and catalogue",
  "author": "TejHorwDev",
  "main": "./out/main/bootstrap.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.bootstrap.config.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run build && electron-builder --win",
    "sim:update": "node scripts/update-sim.mjs",
    "sim:isolation": "node scripts/isolation-sim.mjs",
    "preview:web": "vite --config vite.preview.config.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.5.0",
    "vite": "^8.3.8"
  }
}
