{
  "name": "indra-hub",
  "version": "2.6.0",
  "private": true,
  "description": "INDRA HUB \u2014 desktop workspace",
  "author": "TejHorwDev",
  "main": "./out/main/bootstrap.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.bootstrap.config.mjs",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "sim:update": "node scripts/updater-sim.mjs",
    "sim:admin": "node scripts/admin-sim.mjs",
    "sim:maintenance": "node scripts/maintenance-sim.mjs",
    "sim:appearance": "node scripts/appearance-sim.mjs",
    "sim:workspace": "node scripts/workspace-sim.mjs",
    "sim:team": "node scripts/team-sim.mjs",
    "sim:collab": "node scripts/collab-sim.mjs",
    "sim:offline": "node scripts/offline-sim.mjs",
    "sim:cloud": "node scripts/cloud-sim.mjs",
    "sim:sharing": "node scripts/sharing-sim.mjs",
    "sim:ai": "node scripts/ai-sim.mjs",
    "sim:function": "node scripts/function-sim.mjs",
    "sim:about": "node scripts/about-sim.mjs",
    "sim:credits": "node scripts/credits-sim.mjs",
    "sim:portrait": "node scripts/portrait-sim.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.5.0",
    "vite": "^8.3.8"
  }
}
